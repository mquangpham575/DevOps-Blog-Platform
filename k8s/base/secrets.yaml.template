# Secret for database credentials shared across services
apiVersion: v1
kind: Secret
metadata:
  name: db-credentials
  namespace: blog-app
type: Opaque
stringData:
  POSTGRES_USER: your-database-username
  POSTGRES_PASSWORD: your-database-password
---
# Secret for JWT and mail config
apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: blog-app
type: Opaque
stringData:
  JWT_SECRET: generate-a-32-byte-hex-string-for-jwt-signing
  JWT_EXPIRATION: "86400000"
  MAIL_USERNAME: your-smtp-username@example.com
  MAIL_PASSWORD: your-smtp-app-password
