apiVersion: v1
kind: Secret
metadata:
  name: grafana-secrets
  namespace: monitoring
type: Opaque
stringData:
  # Replace with your desired Grafana admin password (in plain text)
  GRAFANA_PASSWORD: admin123
---
apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-secrets
  namespace: monitoring
type: Opaque
stringData:
  # Replace with your Gmail App Password (in plain text)
  smtp_password: YOUR_GMAIL_APP_PASSWORD

